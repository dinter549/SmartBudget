<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <ImageView
        android:id="@+id/image_jar_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:tint="?attr/colorPrimary"
        tools:src="@drawable/ic_placeholder_jar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Иконка кувшина"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_jar_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        tools:text="Кувшин"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/image_jar_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/image_jar_icon"
        app:layout_constraintBottom_toBottomOf="@id/image_jar_icon"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_jar_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="5 500 ₽ / 10 000 ₽"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/image_jar_icon" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_jar_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="(55%)"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/text_jar_amount" />


    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_jar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:progress="55"
        app:indicatorColor="?attr/colorPrimary"
        app:trackCornerRadius="4dp"
        app:layout_constraintTop_toBottomOf="@id/text_jar_amount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>